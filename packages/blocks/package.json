{
  "name": "@elyri/blocks",
  "version": "0.0.1",
  "description": "Copy-and-own page sections (hero, pricing, CTA…) built on @elyri/motion and @elyri/ui.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechCat-Team/Elyri.git",
    "directory": "packages/blocks"
  },
  "type": "module",
  "files": [
    "dist",
    "src/components"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@elyri/motion": "workspace:*",
    "@elyri/ui": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@elyri/motion": "workspace:*",
    "@elyri/ui": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "react",
    "blocks",
    "sections",
    "landing-page",
    "component-library"
  ],
  "publishConfig": {
    "access": "public"
  }
}
